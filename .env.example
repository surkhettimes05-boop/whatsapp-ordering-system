# Server Configuration
PORT=5000
NODE_ENV=development
DOMAIN=localhost

# Database
DATABASE_URL="postgresql://postgres:password@postgres:5432/whatsapp_ordering?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+14155238886
FORCE_TWILIO_VERIFY=false
WEBHOOK_URL=https://your-domain.com/api/v1/whatsapp/webhook

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Logging
LOG_LEVEL=info

# Public HTTPS base URL used for product image links in WhatsApp
PUBLIC_BASE_URL=https://your-domain.com

# WhatsApp transport
# Use "meta" for JioMart-style native product lists and interactive commerce.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API
META_GRAPH_VERSION=v26.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_CATALOG_ID=

# Meta Commerce Manager scheduled catalog feed protection
CATALOG_FEED_TOKEN=replace_with_random_feed_token
PUBLIC_SHOP_URL=https://your-domain.com

# Nepal online payment adapter
# Native WhatsApp business payments are not available in Nepal.
PAYMENT_PROVIDER=external
PAYMENT_CHECKOUT_BASE_URL=https://your-payment-checkout.example/checkout

# Nepal payment gateways
# Keep sandbox during development. Switch to production only after merchant approval.
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
# Optional override; defaults to Khalti sandbox/production endpoint based on KHALTI_ENV.
KHALTI_BASE_URL=

ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Optional endpoint overrides for merchant-specific environments.
ESEWA_FORM_URL=
ESEWA_STATUS_URL=
