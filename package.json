{
  "name": "whatsapp-backend",
  "version": "1.0.0",
  "description": "Standalone WhatsApp Ordering System Backend",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:seed": "node seed-admin.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "jest --verbose --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "node check-setup.js",
    "setup": "npm install && npx prisma generate && node check-setup.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "smoke:production": "node scripts/production-smoke.js",
    "smoke:providers": "node scripts/provider-smoke.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "geolib": "^3.3.4",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "node-cron": "^4.6.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.18.0",
    "twilio": "^5.12.0",
    "winston": "^3.19.0",
    "pino-http": "^11.0.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "pino-pretty": "^13.1.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
